# Limits for colleagues' scheduled jobs. The runner (claude-agent-jobs.service) enforces them; agent-job shows them.
# Change a value, then: sudo systemctl restart claude-agent-jobs
JOB_MAX_PER_USER=10
JOB_MIN_REMIND_MINUTES=15
JOB_MIN_TASK_MINUTES=60
JOB_TASK_DAILY_CAP=24
JOB_TASK_TIMEOUT_SECONDS=600
JOB_MAX_TURNS=25
JOB_CONCURRENT_BOX=2
JOB_MEMORY_MAX=1536M
JOB_CPU_QUOTA=100%
JOB_FAILURES_TO_PAUSE=3
JOB_TZ=Asia/Kolkata
