# /etc/claude-agent/bridge.env  (mode 640, root). No secret VALUES here: the key stays in its own file.
PROJECT_ID=
SUBSCRIPTION_ID=
# Path to the service-account JSON key (chmod 600, owned by root). Never put its contents here.
GOOGLE_APPLICATION_CREDENTIALS=/etc/claude-agent/chat-bot-key.json
# Minutes an agent may wait on its user before the bot nudges them in Chat.
NUDGE_MINUTES=5
# Second nudge this many minutes after the first, then a reminder every NUDGE_REPEAT_MINUTES. Nothing is auto-denied.
NUDGE_SECOND_GAP_MINUTES=5
NUDGE_REPEAT_MINUTES=30
# Only accept messages from this email domain (leave empty to accept any registered email).
ALLOWED_EMAIL_DOMAIN=
# Minutes the sign-in link/code stays valid.
LOGIN_TTL_SECONDS=600
# Linux user of the admin: claude-agent-monitor's box alerts (memory, disk, out-of-memory kills) go to their DM.
ADMIN_PERSON=
# Where a session id turns into a link.
SESSION_LINK_BASE=https://claude.ai/code/
LOG_LEVEL=INFO
# Two-way Chat limits (each person, per day unless said otherwise).
# Runs a person may start from Chat: each new task and each reply in a task's thread counts as one.
CHAT_TASKS_PER_DAY=30
# Chat runs going at the same time on the WHOLE box (tasks, answer runs and do-it runs of everyone together);
# more wait in a queue until one ends.
CHAT_RUNS_AT_ONCE=2
# Questions one person's agents may ask colleagues.
ASKS_PER_DAY=10
# Questions one person may be asked by colleagues' agents.
ASKS_RECEIVED_PER_DAY=20
# Seconds a person has to approve (yes/no) their own agent's question before it expires unsent. Only unapproved
# questions expire: one handed to a colleague waits for them (the asking agent itself gives up after 8 hours).
ASK_APPROVAL_SECONDS=7200
# Seconds an answer may sit unread in the asking agent's inbox (its ask-colleague stopped waiting) before the bot
# removes it and posts the answer in the asker's own DM instead; the question is then closed.
ASK_DM_FALLBACK_SECONDS=120
# Longest result (characters) a Chat run posts back in its thread.
CHAT_RESULT_CHARS=1500
