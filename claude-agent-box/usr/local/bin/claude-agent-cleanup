#!/usr/bin/python3 -I
"""Daily disk cleanup for the agent box (root, claude-agent-cleanup.timer, 09:00 IST). The disk is small; this keeps
it from filling again. Each step is independent: one that fails is logged and the rest still run.

  1 Docker       images unused for 72 h, anonymous unused volumes (never -a), build cache older than 72 h
  2 Journal      journalctl --vacuum-time=7d
  3 /tmp         /tmp/claude-<uid>: files whose mtime AND atime are over 2 days old, then empty subfolders
  4 Results      each active person's ~/.claude/chat-results/* and job-results/* over 14 days old, and
                 /var/lib/claude-agent/backup/* over 14 days old
  5 Worktrees    of every person in people.json: removed only when clean, already pushed, untouched for 3 days and
                 not any process's working directory. Git runs AS the person, never as root in their tree, and never
                 with --force. One kept over 7 days for unsaved or unpushed work is reported ONCE to its owner
                 (notify-me --source job:cleanup); /var/lib/claude-agent/cleanup-state.json remembers which.

Never touched: /var/log/claude-agent/*.jsonl (audit trail), base copies of repos, Maven/npm caches, anything else in a
home. One summary line at the end (bytes freed per step, worktrees removed and kept); no file contents.

  claude-agent-cleanup             clean now (what the timer runs)
  claude-agent-cleanup --dry-run   print what would go and how much it would free; change nothing

Exits 0 even when a step failed (the summary lists failures); 2 only for bad arguments.
"""
import argparse
import dataclasses
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import time

LIB = "/usr/local/lib/claude-agent"
sys.path.insert(0, LIB)
import agent_outbox  # noqa: E402

PEOPLE = "/etc/claude-agent/people.json"
STATE = "/var/lib/claude-agent/cleanup-state.json"
BACKUP = "/var/lib/claude-agent/backup"
NOTIFY_ME = "/usr/local/bin/notify-me"

DAY = 86400
DOCKER_AGE = "72h"
JOURNAL_KEEP = "7d"
TMP_AGE = 2 * DAY
RESULTS_AGE = 14 * DAY
WORKTREE_QUIET = 3 * DAY       # nothing in it modified this recently, or it is still being used
WORKTREE_REPORT_AGE = 7 * DAY  # a kept worktree this old is reported to its owner, once
RESULT_DIRS = (".claude/chat-results", ".claude/job-results")
TMP_RE = re.compile(r"^claude-[0-9]+$")
USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
DOCKER_UNITS = {"B": 1, "kB": 1000, "KB": 1000, "MB": 1000 ** 2, "GB": 1000 ** 3, "TB": 1000 ** 4}
JOURNAL_UNITS = {"B": 1, "K": 1024, "M": 1024 ** 2, "G": 1024 ** 3, "T": 1024 ** 4}


def default_run(argv, user=None, home=None, timeout=600):
    """(returncode, stdout). With user, the command runs as that person with their HOME; otherwise as root."""
    if user:
        argv = ["runuser", "-u", user, "--", "env", "HOME=" + (home or ""), "GIT_TERMINAL_PROMPT=0"] + list(argv)
    p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, cwd="/", stdin=subprocess.DEVNULL)
    return p.returncode, p.stdout


def default_home_of(user):
    import pwd
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        return None
    return (pw.pw_uid, pw.pw_dir) if os.path.isdir(pw.pw_dir) and not os.path.islink(pw.pw_dir) else None


def default_cwds(proc="/proc"):
    out = []
    try:
        pids = [p for p in os.listdir(proc) if p.isdigit()]
    except OSError:
        return out
    for pid in pids:
        try:
            out.append(os.readlink(os.path.join(proc, pid, "cwd")).replace(" (deleted)", ""))
        except OSError:
            continue
    return out


@dataclasses.dataclass
class Cfg:
    dry_run: bool = False
    now: float = 0.0
    tmp: str = "/tmp"
    backup: str = BACKUP
    people_file: str = PEOPLE
    state_file: str = STATE
    run: object = default_run
    which: object = shutil.which
    home_of: object = default_home_of
    cwds: object = default_cwds
    out: object = print


# ------------------------------------------------------------------ helpers
def _listdir(d):
    try:
        return sorted(os.listdir(d))
    except OSError:
        return []


def _real_dir(path):
    return os.path.isdir(path) and not os.path.islink(path)


def _people(path, active_only=False):
    try:
        with open(path) as f:
            people = json.load(f).get("people", [])
    except (OSError, ValueError, AttributeError):
        return []
    out = []
    for p in people:
        user = p.get("linux_user") if isinstance(p, dict) else None
        if isinstance(user, str) and USER_RE.match(user) and (not active_only or p.get("status") == "active"):
            out.append(user)
    return out


def _du(top):
    """Disk used under top in bytes, never following a link."""
    total = 0
    try:
        total = os.lstat(top).st_blocks * 512
    except OSError:
        return 0
    for root, dirs, files in os.walk(top, followlinks=False):
        for name in files + dirs:
            try:
                total += os.lstat(os.path.join(root, name)).st_blocks * 512
            except OSError:
                pass
    return total


def _parse_size(text, pattern, units):
    m = re.search(pattern, text or "")
    if not m:
        return 0
    try:
        return int(float(m.group(1)) * units.get(m.group(2), 0))
    except ValueError:
        return 0


def _check(rc, what):
    if rc != 0:
        raise RuntimeError("%s exited %s" % (what, rc))


# ------------------------------------------------------------------ 1 + 2: docker, journal
def step_docker(cfg):
    if not cfg.which("docker"):
        return {"freed": 0, "skipped": True}
    cmds = [["docker", "image", "prune", "-a", "-f", "--filter", "until=" + DOCKER_AGE],
            ["docker", "volume", "prune", "-f"],                      # never -a: that would take named volumes
            ["docker", "builder", "prune", "-f", "--filter", "until=" + DOCKER_AGE]]
    freed, bad = 0, []
    for cmd in cmds:
        if cfg.dry_run:
            cfg.out("would run: " + " ".join(cmd))
            continue
        try:
            rc, out = cfg.run(cmd)
        except Exception as e:                                        # noqa: BLE001 - the next command still runs
            bad.append("%s (%s)" % (" ".join(cmd[:3]), e))
            continue
        if rc != 0:
            bad.append("%s exited %s" % (" ".join(cmd[:3]), rc))
        freed += _parse_size(out, r"reclaimed space:\s*([0-9.]+)\s*([kKMGT]?B)", DOCKER_UNITS)
    if bad:
        raise RuntimeError("; ".join(bad))
    return {"freed": freed}


def step_journal(cfg):
    cmd = ["journalctl", "--vacuum-time=" + JOURNAL_KEEP]
    if cfg.dry_run:
        cfg.out("would run: " + " ".join(cmd))
        return {"freed": 0}
    rc, out = cfg.run(cmd)
    _check(rc, "journalctl")
    return {"freed": _parse_size(out, r"freed\s+([0-9.]+)\s*([BKMGT])", JOURNAL_UNITS)}


# ------------------------------------------------------------------ 3: /tmp/claude-<uid>
def _clean_tmp_dir(cfg, top, dev):
    cutoff, gone, freed = cfg.now - TMP_AGE, set(), 0
    for root, dirs, files, rootfd in os.fwalk(top, topdown=False, follow_symlinks=False):
        try:
            if os.fstat(rootfd).st_dev != dev:                        # another filesystem: leave it alone
                continue
        except OSError:
            continue
        subdirs = []
        for name in files + dirs:
            try:
                st = os.stat(name, dir_fd=rootfd, follow_symlinks=False)
            except OSError:
                continue
            if stat.S_ISDIR(st.st_mode):
                subdirs.append(name)
                continue
            if not (stat.S_ISREG(st.st_mode) or stat.S_ISLNK(st.st_mode)) or st.st_dev != dev:
                continue
            # a file: changed or read recently keeps it. A link's own atime is moved by the walk itself (listing a
            # directory looks through its links), so for a link only its own mtime counts.
            if (st.st_mtime if stat.S_ISLNK(st.st_mode) else max(st.st_mtime, st.st_atime)) >= cutoff:
                continue
            if not cfg.dry_run:
                try:
                    os.unlink(name, dir_fd=rootfd)                    # the entry itself, never a link's target
                except OSError:
                    continue
            else:
                cfg.out("would remove: " + os.path.join(root, name))
            gone.add(os.path.join(root, name))
            freed += st.st_size if stat.S_ISREG(st.st_mode) else 0
        for name in subdirs:
            path = os.path.join(root, name)
            if cfg.dry_run:
                if all(os.path.join(path, e) in gone for e in _listdir(path)):
                    gone.add(path)
            else:
                try:
                    os.rmdir(name, dir_fd=rootfd)                     # only succeeds when empty
                except OSError:
                    pass
    return freed


def step_tmp(cfg):
    freed = 0
    for name in _listdir(cfg.tmp):
        if not TMP_RE.match(name):
            continue
        top = os.path.join(cfg.tmp, name)
        try:
            st = os.lstat(top)
        except OSError:
            continue
        if stat.S_ISDIR(st.st_mode):                                  # a planted symlink is not a directory here
            freed += _clean_tmp_dir(cfg, top, st.st_dev)
    return {"freed": freed}


# ------------------------------------------------------------------ 4: results and backups
def step_results(cfg):
    cutoff, freed = cfg.now - RESULTS_AGE, 0
    for user in _people(cfg.people_file, active_only=True):
        info = cfg.home_of(user)
        if not info:
            continue
        uid, home = info
        for rel in RESULT_DIRS:
            try:
                dfd = agent_outbox.open_user_dir(home, rel, uid)      # no symlink at any step, every step the user's
            except OSError:
                continue
            try:
                for name in sorted(os.listdir(dfd)):
                    try:
                        st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
                    except OSError:
                        continue
                    if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_mtime >= cutoff:
                        continue
                    if cfg.dry_run:
                        cfg.out("would remove: %s/%s/%s" % (home, rel, name))
                    else:
                        try:
                            os.unlink(name, dir_fd=dfd)
                        except OSError:
                            continue
                    freed += st.st_size
            finally:
                os.close(dfd)
    return {"freed": freed}


def step_backups(cfg):
    cutoff, freed = cfg.now - RESULTS_AGE, 0
    if not _real_dir(cfg.backup):
        return {"freed": 0}
    for name in _listdir(cfg.backup):
        path = os.path.join(cfg.backup, name)
        try:
            st = os.lstat(path)
        except OSError:
            continue
        if not stat.S_ISDIR(st.st_mode) or st.st_mtime >= cutoff:     # a symlink is not a directory to lstat
            continue
        size = _du(path)
        if cfg.dry_run:
            cfg.out("would remove: " + path)
        else:
            shutil.rmtree(path)
        freed += size
    return {"freed": freed}


# ------------------------------------------------------------------ 5: worktrees
def _worktree_dirs(home):
    vylo = os.path.join(home, "Documents", "code", "vylo")
    if not _real_dir(vylo):
        return []
    parents = [os.path.join(vylo, ".worktrees")]
    parents += [os.path.join(vylo, r, ".claude", "worktrees") for r in _listdir(vylo)
                if not r.startswith(".") and _real_dir(os.path.join(vylo, r, ".claude"))]
    dirs = []
    for parent in parents:
        if _real_dir(parent):
            dirs += [os.path.join(parent, d) for d in _listdir(parent) if _real_dir(os.path.join(parent, d))]
    return dirs


def _modified_since(top, cutoff):
    """True as soon as anything under top (except .git) was modified at or after cutoff. Never follows links."""
    try:
        if os.lstat(top).st_mtime >= cutoff:
            return True
    except OSError:
        return True
    for root, dirs, files in os.walk(top, followlinks=False):
        if root == top and ".git" in dirs:
            dirs.remove(".git")
        for name in files + dirs:
            if root == top and name == ".git":
                continue
            try:
                if os.lstat(os.path.join(root, name)).st_mtime >= cutoff:
                    return True
            except OSError:
                return True
    return False


def _in_use(wt, cwds):
    real = os.path.realpath(wt)
    return any(c == real or c.startswith(real + "/") for c in cwds)


def _printable(path):
    return "".join(ch if ch.isprintable() else "?" for ch in path)


def _load_state(path):
    try:
        with open(path) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def _save_state(path, state):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(state, f)
    os.replace(tmp, path)


def _judge(cfg, user, home, wt, cwds):
    """Why this worktree must stay: a list of reasons (empty = safe to remove)."""
    def git(*args):
        return cfg.run(["git", "-C", wt] + list(args), user=user, home=home, timeout=120)

    try:
        if not stat.S_ISREG(os.lstat(os.path.join(wt, ".git")).st_mode):
            return ["not_linked_worktree"]                            # a standalone clone, not ours to remove
    except OSError:
        return ["not_linked_worktree"]
    reasons = []
    rc, out = git("status", "--porcelain")
    if rc != 0:
        return ["git_error"]
    if out.strip():
        reasons.append("dirty")
    rc, out = git("branch", "-r", "--contains", "HEAD")
    if rc != 0:
        return reasons + ["git_error"]
    if not out.strip():
        reasons.append("unpushed")
    if _modified_since(wt, cfg.now - WORKTREE_QUIET):
        reasons.append("recent_change")
    if _in_use(wt, cwds):
        reasons.append("in_use")
    return reasons


def _remove(cfg, user, home, wt):
    def git(*args):
        return cfg.run(["git", "-C", wt] + list(args), user=user, home=home, timeout=300)

    rc, common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    base = None
    if rc == 0 and common.strip():
        common = common.strip()
        base = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    rc, _ = git("worktree", "remove", wt)                             # never --force
    if rc != 0:
        return False
    if base:
        cfg.run(["git", "-C", base, "worktree", "prune"], user=user, home=home, timeout=120)
    return True


def step_worktrees(cfg):
    state = _load_state(cfg.state_file)
    reported = state.get("reported") if isinstance(state.get("reported"), dict) else {}
    cwds = list(cfg.cwds())
    res = {"freed": 0, "removed": 0, "kept": 0, "reported": 0}
    seen, homes = set(), []
    for user in _people(cfg.people_file):
        info = cfg.home_of(user)
        if not info:
            continue
        uid, home = info
        homes.append(home.rstrip("/") + "/")
        for wt in _worktree_dirs(home):
            seen.add(wt)
            try:
                reasons = _judge(cfg, user, home, wt, cwds)
            except Exception as e:                                    # noqa: BLE001 - keep it, go on
                cfg.out("kept (error %s): %s" % (type(e).__name__, wt))
                res["kept"] += 1
                continue
            if not reasons:
                size = _du(wt)
                if cfg.dry_run:
                    cfg.out("would remove worktree: " + wt)
                elif not _remove(cfg, user, home, wt):
                    cfg.out("kept (git would not remove it): " + wt)
                    res["kept"] += 1
                    continue
                else:
                    cfg.out("removed worktree: " + wt)
                res["removed"] += 1
                res["freed"] += size
                continue
            res["kept"] += 1
            cfg.out("kept (%s): %s" % (", ".join(reasons), wt))
            if not set(reasons) <= {"dirty", "unpushed"} or wt in reported:
                continue                                              # still in use, or already told
            try:
                old = cfg.now - os.lstat(os.path.join(wt, ".git")).st_mtime > WORKTREE_REPORT_AGE
            except OSError:
                continue
            if not old:
                continue
            if cfg.dry_run:
                cfg.out("would tell %s: %s" % (user, wt))
                continue
            text = ("Old worktree kept because it has unsaved or unpushed work: %s. "
                    "Push or remove it when you're done." % _printable(wt))
            try:
                rc, _ = cfg.run([NOTIFY_ME, "--source", "job:cleanup", text], user=user, home=home, timeout=60)
            except Exception:                                         # noqa: BLE001 - try again tomorrow
                rc = 1
            if rc == 0:
                reported[wt] = int(cfg.now)
                res["reported"] += 1
    if not cfg.dry_run:
        # forget worktrees that are gone (of the people we looked at), so a new one at that path is reported again
        reported = {p: t for p, t in reported.items() if p in seen or not any(p.startswith(h) for h in homes)}
        state["reported"] = reported
        try:
            _save_state(cfg.state_file, state)
        except OSError as e:
            cfg.out("could not save %s: %s" % (cfg.state_file, e))
    return res


# ------------------------------------------------------------------ whole run
STEPS = (("docker", step_docker), ("journal", step_journal), ("tmp", step_tmp), ("results", step_results),
         ("backups", step_backups), ("worktrees", step_worktrees))


def run_all(cfg):
    summary = {"steps": {}, "failed": []}
    for name, fn in STEPS:
        try:
            summary["steps"][name] = fn(cfg)
        except Exception as e:                                        # noqa: BLE001 - one step never stops the rest
            summary["steps"][name] = {"freed": 0}
            summary["failed"].append(name)
            print("step %s failed: %s: %s" % (name, type(e).__name__, e), file=sys.stderr)
    return summary


def _fmt(n):
    for unit, size in (("GB", 1024 ** 3), ("MB", 1024 ** 2), ("KB", 1024)):
        if n >= size:
            return "%.1f%s" % (n / size, unit)
    return "%dB" % n


def summary_line(s, dry_run):
    st = s["steps"]
    freed = {k: st.get(k, {}).get("freed", 0) for k, _ in STEPS}
    wt = st.get("worktrees", {})
    parts = ["%s=%s" % (k, _fmt(freed[k])) for k in ("docker", "journal", "tmp", "results", "backups")]
    parts.append("worktrees=%s" % _fmt(freed["worktrees"]))
    parts.append("worktrees_removed=%d worktrees_kept=%d" % (wt.get("removed", 0), wt.get("kept", 0)))
    parts.append("failed=%s" % (",".join(s["failed"]) or "none"))
    return "claude-agent-cleanup%s: freed %s" % (" (dry run, nothing changed)" if dry_run else "", " ".join(parts))


def main(argv):
    ap = argparse.ArgumentParser(prog="claude-agent-cleanup", description="Daily disk cleanup for the agent box.")
    ap.add_argument("--dry-run", action="store_true", help="print what would be removed; change nothing")
    args = ap.parse_args(argv)                                        # bad arguments: exit 2
    cfg = Cfg(dry_run=args.dry_run, now=time.time())
    s = run_all(cfg)
    print(summary_line(s, args.dry_run))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
